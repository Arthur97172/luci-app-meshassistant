{
	"luci-app-meshassistant": {
		"description": "Grant access to luci-app-meshassistant",
		"read": {
			"ubus": {
				"file": [ "exec" ],
				"luci-rpc": [ "getWirelessDevices" ],
				"network.interface": [ "status" ],
				"iwinfo": [ "freqlist", "countrylist" ]
			},
			"file": {
				"/usr/sbin/batctl n": [ "exec" ],
				"/usr/sbin/batctl o": [ "exec" ],
				"/etc/meshassistant/shell/meshassistant.sh linkinfo": [ "exec" ],
				"/etc/meshassistant/shell/meshassistant.sh backup list": [ "exec" ],
				"/tmp/meshassistant_peers": [ "read" ],
				"/tmp/meshassistant.log": [ "read" ]
			},
			"uci": [ "meshassistant", "network", "wireless" ]
		},
		"write": {
			"ubus": {
				"file": [ "exec" ]
			},
			"file": {
				"/etc/meshassistant/shell/meshassistant.sh --detach": [ "exec" ],
				"/etc/meshassistant/shell/meshassistant.sh --detach dumbap": [ "exec" ],
				"/etc/meshassistant/shell/meshassistant.sh --detach backup restore": [ "exec" ],
				"/etc/meshassistant/shell/meshassistant.sh clearlog": [ "exec" ],
				"/etc/meshassistant/shell/meshassistant.sh backup create": [ "exec" ],
				"/etc/meshassistant/shell/meshassistant.sh backup delete": [ "exec" ],
				"/etc/meshassistant/shell/meshassistant.sh backup clear": [ "exec" ],
				"/tmp/meshassistant_backup_selection": [ "write" ]
			},
			"uci": [ "meshassistant" ]
		}
	}
}

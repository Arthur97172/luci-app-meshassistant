#!/bin/sh

if [ ! -f /etc/config/meshassistant ]; then
    echo "Creating /etc/config/meshassistant"
    cat <<EOF > /etc/config/meshassistant
config meshassistant 'config'
        option enabled '0'
EOF
	reload_config
else
	echo "/etc/config/meshassistant exists, skipping creation"
fi

uci -q batch <<-EOF >/dev/null
	delete ucitrack.@meshassistant[-1]
	add ucitrack meshassistant
	set ucitrack.@meshassistant[-1].init=meshassistant
	commit ucitrack
EOF

rm -f /tmp/luci-indexcache

# The peer identity service is enabled at boot; it only starts while
# meshassistant.config.enabled is 1.  Restart it so an upgrade running the
# script from its old path switches to the installed one.
if [ -x /etc/init.d/meshassistant ]; then
	/etc/init.d/meshassistant enable
	/etc/init.d/meshassistant restart
fi
exit 0

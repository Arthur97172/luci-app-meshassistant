#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get meshassistant.config.enabled)" = 1 ] || return 0
	command -v socat >/dev/null 2>&1 || return 0

	procd_open_instance
	procd_set_param command /etc/meshassistant/shell/meshassistant.sh daemon
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	rm -f /tmp/meshassistant_peers
}

reload_service() {
	stop
	start
}

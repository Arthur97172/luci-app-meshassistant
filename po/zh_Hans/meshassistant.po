msgid ""
msgstr ""
"Project-Id-Version: luci-app-meshassistant\n"
"Language: zh_Hans\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "Advanced Settings"
msgstr "高级设置"

msgid "AP Mode"
msgstr "AP 模式"

msgid "Auto"
msgstr "自动"

msgid "Backhaul"
msgstr "回程类型"

msgid "Backhaul Status"
msgstr "回程状态"

msgid "Bad RSSI Threshold"
msgstr "较差 RSSI 阈值"

msgid "Band"
msgstr "频段"

msgid "Band plan of this radio (read-only)."
msgstr "该射频的频段划分（只读）。"

msgid "Basic Setup"
msgstr "基础设置"

msgid "Cancel"
msgstr "取消"

msgid "Channel"
msgstr "信道"

msgid "Channel %s (%s MHz)"
msgstr "信道 %s（%s MHz）"

msgid "Channel %s (%s MHz, DFS)"
msgstr "信道 %s（%s MHz，DFS）"

msgid "Channel Utilization"
msgstr "信道占用率"

msgid "Channel Width"
msgstr "通道宽度"

msgid "Channel bandwidth / channel bonding. Leave at “Keep current” to keep the radio width."
msgstr "信道带宽 / 信道捆绑。保留“保持当前值”则不改动射频宽度。"

msgid "Channel planning / frequency assignment. Leave at “Keep current” to keep the radio channel."
msgstr "信道规划 / 频率指配。保留“保持当前值”则不改动射频信道。"

msgid "Choose if the node uses DHCP or a Static IP"
msgstr "选择节点使用 DHCP 还是静态 IP"

msgid "Choose whether this device is a Server, Client, or Node in the mesh network."
msgstr "选择此设备在 Mesh 网络中作为服务器、客户端还是节点。"

msgid "Clear Log"
msgstr "清空日志"

msgid "Client"
msgstr "客户端"

msgid "Combine two selected radios into one Wi-Fi 7 Multi-Link Operation (MLO) access point. The radios are switched to EHT mode. MLO requires exactly two radios."
msgstr "将所选的两个射频合并为一个 Wi-Fi 7 多链路操作（MLO）接入点，射频会自动切换为 EHT 模式。启用 MLO 需要恰好选择两个射频。"

msgid "DAWN keeps restarting (respawn count: %d), so client steering is interrupted. Check the system log."
msgstr "DAWN 反复重启（重启计数：%d），客户端引导会中断。请查看系统日志。"

msgid "DHCP"
msgstr "DHCP"

msgid "DNS Server"
msgstr "DNS 服务器"

msgid "The DNS server for this node. In DHCP mode it replaces the DNS servers advertised by the DHCP server; leave it empty to use them."
msgstr "本机使用的 DNS 服务器。DHCP 模式下会覆盖 DHCP 服务器下发的 DNS；留空则使用下发的 DNS。"

msgid "Mesh Assistant"
msgstr "MESH助手"

msgid "Enable Dumb AP Mode"
msgstr "启用哑 AP 模式"

msgid "Enable Mesh Networking"
msgstr "启用 Mesh 网络"

msgid "Enable MLO"
msgstr "启用 MLO"

msgid "Enable this switch to require a password to join your Mesh Network."
msgstr "启用此开关后，加入 Mesh 网络需要密码。"

msgid "Ensure that the SSID is the same across all the servers/nodes in your mesh network."
msgstr "确保 Mesh 网络中所有服务器/节点使用相同的 SSID。"

msgid "Enter a mesh network SSID."
msgstr "请输入 Mesh 网络 SSID。"

msgid "Enter a static IPv4 address."
msgstr "请输入静态 IPv4 地址。"

msgid "Enter a valid IPv4 netmask, for example 255.255.255.0."
msgstr "请输入有效的 IPv4 子网掩码，例如 255.255.255.0。"

msgid "Failed to apply mesh settings: %s"
msgstr "应用 Mesh 设置失败：%s"

msgid "Failed to clear the log: %s"
msgstr "清空日志失败：%s"

msgid "Failed to refresh the log: %s"
msgstr "刷新日志失败：%s"

msgid "Frequency"
msgstr "频率"

msgid "Good RSSI Threshold"
msgstr "良好 RSSI 阈值"

msgid "DAWN scores a connection as good at or above this signal level."
msgstr "信号电平达到或高于该值时，DAWN 会把连接评为良好。"

msgid "IP Address"
msgstr "IP 地址"

msgid "IPv4 netmask"
msgstr "IPv4 子网掩码"

msgid "IP Mode"
msgstr "IP 模式"

msgid "In Use"
msgstr "使用中"

msgid "Interface"
msgstr "接口"

msgid "Client Roaming (802.11k/v)"
msgstr "客户端漫游（802.11k/v）"

msgid "Let DAWN steer clients to the strongest access point. Requires a full wpad build; wpad-basic lacks 802.11v, so roaming stays off."
msgstr "由 DAWN 引导客户端切换到信号最强的接入点。需要完整版 wpad；wpad-basic 不支持 802.11v，漫游将保持关闭。"

msgid "Fast Roaming (802.11r)"
msgstr "快速漫游（802.11r）"

msgid "Let clients move between access points without re-authenticating. Uses the Mobility Domain below."
msgstr "让客户端在接入点之间切换时无需重新认证，使用下方的移动域。"

msgid "Client roaming is on, but this wpad build lacks 802.11v. Install a full wpad build or turn roaming off."
msgstr "漫游已开启，但当前 wpad 不支持 802.11v。请安装完整版 wpad 或关闭漫游。"

msgid "Client roaming is on, but DAWN is not installed, so clients are not steered."
msgstr "漫游已开启，但 DAWN 未安装，客户端不会被引导。"

msgid "Client roaming is on, but the DAWN service is not running, so clients are not steered."
msgstr "漫游已开启，但 DAWN 服务未在运行，客户端不会被引导。"

msgid "This device supports 802.11k/v; client roaming can be enabled in Advanced Settings."
msgstr "这台设备支持 802.11k/v，可在「高级设置」中开启客户端漫游。"

msgid "Keep current (%s)"
msgstr "保持当前值（%s）"

msgid "Keep this enabled when the Mesh server is the only gateway and should provide DHCP and IPv6 RA for the LAN. Disable it when another router on the LAN already provides DHCP: the server then keeps the gateway and DNS role but stops its own DHCP/RA server."
msgstr "当 Mesh 服务器是唯一网关并为 LAN 提供 DHCP 和 IPv6 RA 时，请保持启用。若 LAN 上已有其他路由器提供 DHCP，请关闭此项：服务器仍保留网关和 DNS 角色，但会停止自身的 DHCP/RA 服务。"

msgid "Below this signal level DAWN treats the connection as poor and asks the client to move to a better access point."
msgstr "低于该信号电平时，DAWN 会把连接视为较差，并请求客户端切换到更好的接入点。"

msgid "Link Rate"
msgstr "链路速率"

msgid "Load"
msgstr "负载"

msgid "Local Host"
msgstr "本机"

msgid "MLO requires exactly two radios."
msgstr "启用 MLO 需要恰好选择两个射频。"

msgid "Make sure the “Server” and the “Node” or “Client” use the same settings."
msgstr "请确保“服务器”与“节点”或“客户端”之间使用相同的配置。"

msgid "Maximum Transmit Power"
msgstr "最大传输功率"

msgid "Mesh Gateway IP Address"
msgstr "Mesh 网关 IP 地址"

msgid "Mesh Mode"
msgstr "Mesh 模式"

msgid "Mesh Network SSID"
msgstr "Mesh 网络 SSID"

msgid "Mesh Password"
msgstr "Mesh 密码"

msgid "Mesh Radio"
msgstr "Mesh 射频"

msgid "Mesh Settings"
msgstr "Mesh 设置"

msgid "Mesh Status"
msgstr "Mesh 状态"

msgid "Mesh settings are being applied in the background."
msgstr "Mesh 设置正在后台应用。"

msgid "Mobility Domain"
msgstr "移动域"

msgid "No log entries."
msgstr "暂无日志。"

msgid "No neighbor nodes found."
msgstr "未找到邻居节点。"

msgid "Node"
msgstr "节点"

msgid "Node Hostname"
msgstr "节点主机名"

msgid "Node MAC"
msgstr "节点MAC"

msgid "None (wireless backhaul only)"
msgstr "无（仅无线回程）"

msgid "Number of Active Nodes: %d"
msgstr "活动节点数：%d"

msgid "Password Protection"
msgstr "密码保护"

msgid "PHY Mode"
msgstr "PHY 模式"

msgid "PHY layer protocol mode. Leave at “Keep current” to keep the radio mode."
msgstr "PHY 层协议模式。保留“保持当前值”则不改动射频模式。"

msgid "Regular AP Radio"
msgstr "普通 AP 射频"

msgid "Reapply meshassistant Settings"
msgstr "重新应用 MESH助手设置"

msgid "Refresh Log"
msgstr "刷新日志"

msgid "Regulatory domain (ISO/IEC 3166 alpha-2). Leave at “Keep current” to keep the current country code."
msgstr "法规域（ISO/IEC 3166 alpha-2）。保留“保持当前值”则保持当前国家代码。"

msgid "Remote Hosts"
msgstr "远程主机"

msgid "Run Log"
msgstr "运行日志"

msgid "Select at least one radio."
msgstr "请至少选择一个射频。"

msgid "Select one or more radios (2.4 GHz, 5 GHz and 6 GHz) for the regular WiFi access point. The SSID for each radio can be configured below."
msgstr "选择一个或多个射频（2.4 GHz、5 GHz 与 6 GHz）用于普通 WiFi 接入点。各射频的 SSID 可在下方配置。"

msgid "Select one radio interface for mesh backhaul traffic."
msgstr "选择一个用于 Mesh 回程流量的射频接口。"

msgid "Select the Ethernet port cabled to another Mesh device. The port is dedicated to wired backhaul and removed from the LAN bridge. Wired is used while the cable is connected; the Mesh radio is used when it is not. Choose None for wireless-only backhaul."
msgstr "选择连接到另一台 Mesh 设备的以太网端口。该端口将专用于有线回程并从 LAN 网桥中移除。网线连接时使用有线回程；未连接时使用 Mesh 射频。仅使用无线回程请选择“无”。"

msgid "Server"
msgstr "服务器"

msgid "Server Provides DHCP"
msgstr "服务器提供 DHCP"

msgid "Signal Strength"
msgstr "信号强度"

msgid "Spectrum Settings"
msgstr "频谱设置"

msgid "Same SSID"
msgstr "相同 SSID"

msgid "Separate SSIDs"
msgstr "不同 SSID"

msgid "SSID Mode"
msgstr "SSID 模式"

msgid "SSID for %s"
msgstr "SSID（%s）"

msgid "SSID for the regular WiFi network. This SSID is also used by the MLO access point and by radios without their own SSID."
msgstr "普通 WiFi 网络的 SSID。MLO 接入点以及没有单独 SSID 的射频也使用此 SSID。"

msgid "SSID used by this radio when separate SSIDs are enabled. Leave empty to use the shared SSID."
msgstr "启用不同 SSID 时该射频使用的 SSID。留空则使用公共 SSID。"

msgid "Choose whether the selected radios share one SSID or use a separate SSID per radio. Separate SSIDs disable seamless 802.11r roaming between the radios."
msgstr "选择选中的射频共用一个 SSID，还是每个射频使用各自的 SSID。使用不同 SSID 时，射频之间无法通过 802.11r 无缝漫游。"

msgid "Standby"
msgstr "备用"

msgid "Static"
msgstr "静态"

msgid "Static IP Address"
msgstr "静态 IP 地址"

msgid "The selected PHY mode does not support this channel width."
msgstr "所选 PHY 模式不支持该通道宽度。"

msgid "Continue?"
msgstr "继续？"

msgid "Country Code"
msgstr "国家代码"

msgid "driver default"
msgstr "驱动默认值"

msgid "This radio interface reports no frequency band, so no spectrum settings are available."
msgstr "此射频接口未报告频段信息，因此没有可用的频谱设置。"

msgid "Toggle this switch to activate or deactivate the Mesh Network on this device according to the settings specified in this configuration."
msgstr "根据此配置中的设置，切换此开关以启用或停用本设备上的 Mesh 网络。"

msgid "Transmit power / EIRP in dBm. Leave empty to keep the current transmit power."
msgstr "发射功率 / EIRP（dBm）。留空则保持当前发射功率。"

msgid "Unable to read mesh status."
msgstr "无法读取 Mesh 状态。"

msgid "Use this button to apply/reapply meshassistant configuration after you Save & Apply. The AP Mode address is applied here; if the address or the route is not applied correctly, the previous LAN settings are restored automatically."
msgstr "在“保存并应用”之后，使用此按钮应用/重新应用 MESH助手配置。AP 模式的 IP 地址在此生效；如果地址或路由未能正确应用，设备会自动恢复原来的 LAN 设置。"

msgid "WARNING: THIS WILL CHANGE THE IP ADDRESS OF THIS NODE, YOU WILL LOSE ACCESS TO THIS UI"
msgstr "警告：这将更改此节点的 IP 地址，你将无法再访问此界面。"

msgid "WiFi Network SSID"
msgstr "WiFi 网络 SSID"

msgid "Wired"
msgstr "有线"

msgid "Wired Backhaul Port"
msgstr "有线回程端口"

msgid "Wireless"
msgstr "无线"

msgid "A backup of the current configuration is created before restoring."
msgstr "恢复前会先备份当前配置。"

msgid "All backups will be deleted. This cannot be undone."
msgstr "将删除所有备份，此操作无法撤销。"

msgid "Backup Management"
msgstr "备份管理"

msgid "Backups are stored in %s."
msgstr "备份文件保存在 %s。"

msgid "Clear All"
msgstr "清空全部"

msgid "Clear Backups"
msgstr "清空备份"

msgid "Create Backup"
msgstr "创建备份"

msgid "Delete"
msgstr "删除"

msgid "Delete Backup"
msgstr "删除备份"

msgid "Deleting a backup cannot be undone."
msgstr "删除备份后无法恢复。"

msgid "Failed to clear the backups: %s"
msgstr "清空备份失败：%s"

msgid "Failed to create the automatic backup: %s"
msgstr "创建自动备份失败：%s"

msgid "Failed to create the backup: %s"
msgstr "创建备份失败：%s"

msgid "Failed to delete the backup: %s"
msgstr "删除备份失败：%s"

msgid "Failed to read the backups: %s"
msgstr "读取备份列表失败：%s"

msgid "Failed to restore the backup: %s"
msgstr "恢复备份失败：%s"

msgid "Loading backups..."
msgstr "正在加载备份..."

msgid "No backups found."
msgstr "未找到备份。"

msgid "Restore"
msgstr "恢复"

msgid "Restore Backup"
msgstr "手动恢复"

msgid "Restoring a backup overwrites the current network, wireless, DHCP, firewall, system and Mesh Assistant configuration. The connection may drop and the management address may change."
msgstr "恢复备份会覆盖当前的网络、无线、DHCP、防火墙、系统和 MESH助手配置。连接可能中断，管理地址也可能改变。"

msgid "The backup command failed."
msgstr "备份命令执行失败。"

msgid "The backup is being restored in the background. The connection may drop."
msgstr "正在后台恢复备份，连接可能中断。"

msgid "The backup list could not be read."
msgstr "无法读取备份列表。"

msgid "The clear command failed."
msgstr "清空命令执行失败。"

msgid "The delete command failed."
msgstr "删除命令执行失败。"

msgid "The restore command failed."
msgstr "恢复命令执行失败。"

msgid "Connected Devices"
msgstr "联机信息"

msgid "Hostname"
msgstr "主机名"

msgid "MAC Address"
msgstr "MAC 地址"

msgid "IPv4 Address"
msgstr "IPv4 地址"

msgid "Number of Connected Devices: %d"
msgstr "已连接设备数：%d"

msgid "Unable to read the connected devices."
msgstr "无法读取联机信息。"

msgid "No connected devices found."
msgstr "未发现已连接设备。"

msgid "Updated at %s"
msgstr "最后更新：%s"

msgid "Mesh networking is disabled on this device."
msgstr "本机的 Mesh 网络已停用。"

msgid "The last refresh failed; showing the status from %s."
msgstr "最近一次刷新失败，以下是 %s 的状态。"

msgid "Roaming Activity"
msgstr "漫游活动"

msgid "Cumulative 802.11k/v transition counters since hostapd started."
msgstr "自 hostapd 启动以来的 802.11k/v 切换计数器。主机仍在移动但计数不变，说明 wpad 缺少相应功能，而不是 DAWN 阈值设置不当。"

msgid "Neighbor Reports"
msgstr "邻居报告"

msgid "Steering Requests"
msgstr "引导请求"

msgid "Steering Responses"
msgstr "引导响应"

msgid "Suggested channel for this node: %s (%s MHz)."
msgstr "本节点建议信道：%s（%s MHz）。"

msgid "Good RSSI Threshold (%s)"
msgstr "良好 RSSI 阈值（%s）"

msgid "Bad RSSI Threshold (%s)"
msgstr "较差 RSSI 阈值（%s）"

msgid "Leave empty to use the shared threshold above."
msgstr "留空则使用上方的公共阈值。"

msgid "DHCP DNS Server"
msgstr "DHCP 下发的 DNS 服务器"

msgid "The DNS server that DHCP clients receive as DHCP option 6. Leave it empty to let dnsmasq advertise this router."
msgstr "通过 DHCP 选项 6 下发给客户端的 DNS 服务器。留空则仍由 dnsmasq 通告本机地址。"

msgid "This node has no DHCP lease on its LAN interface. Check the uplink cable or the DHCP service on the server."
msgstr "本节点的 LAN 接口未获得 DHCP 租约。请检查上联网线或服务器上的 DHCP 服务。"
